# ============= GENERAL =============
NODE_ENV=development
TZ=America/Bogota
PORT=3000
API_PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ============= DATABASE =============
DATABASE_URL=postgresql://guarne_dev:guarne_dev_pass_2024@localhost:5433/guarne_trading
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ============= REDIS =============
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============= JWT =============
# IMPORTANT: Change these secrets in production!
JWT_SECRET=change-this-super-secret-jwt-key-min-32-chars-for-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-token-secret-min-32-chars-for-production
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key (32 bytes hex) - Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ============= BINANCE TESTNET =============
BINANCE_TESTNET_API_URL=https://testnet.binance.vision/api
BINANCE_TESTNET_WS_URL=wss://testnet.binance.vision/ws
BINANCE_RATE_LIMIT=1200

# ============= FRONTEND =============
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=Guarne Pro
NEXT_PUBLIC_APP_ENV=development

# ============= CORS =============
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
BINANCE_MARKET_DATA_TIMEOUT_MS=10000
BINANCE_WEBSOCKET_BASE_URL=wss://data-stream.binance.vision
BINANCE_WEBSOCKET_RECONNECT_DELAY_MS=2000
MARKET_DATA_CACHE_HOT_WINDOW_MS=300000
MARKET_DATA_REALTIME_RESYNC_CANDLE_LIMIT=5

# ============= OBSERVABILITY =============
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=guarne-api

# ============= S3 STORAGE (MinIO) =============
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET_BACKTESTS=guarne-backtests
S3_BUCKET_EXPORTS=guarne-exports

# ============= RATE LIMITING =============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTHENTICATED_MAX=1000

# ============= BACKTESTING =============
BACKTEST_MAX_CANDLES=100000
BACKTEST_DEFAULT_COMMISSION=0.001
BACKTEST_DEFAULT_SLIPPAGE=0.0005
BACKTEST_TIMEOUT_MS=300000

# ============= COMPETITIONS =============
COMPETITION_DEFAULT_INITIAL_CAPITAL=10000
COMPETITION_MAX_LEVERAGE=3
COMPETITION_REFRESH_INTERVAL_MS=5000
