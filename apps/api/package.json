{
  "name": "@guarne/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API Fastify en JavaScript para Guarne Pro",
  "type": "module",
  "scripts": {
    "build": "node -e \"import('./src/app/create-app.js').then(() => console.log('apps/api build check passed'))\"",
    "start": "node src/server.js",
    "start:dev": "node --watch src/server.js",
    "lint": "eslint . --ext js,mjs",
    "type-check": "node -e \"console.log('TypeScript disabled for @guarne/api')\"",
    "test": "node test/app.smoke.test.js",
    "test:watch": "node --watch test/app.smoke.test.js",
    "test:unit": "node test/app.smoke.test.js",
    "test:integration": "node test/app.smoke.test.js",
    "migrate": "node -e \"console.log('Database migrations are defined in issue #15')\"",
    "seed": "node -e \"console.log('Database seeds are defined in issue #15')\"",
    "db:reset": "node -e \"console.log('Database reset is defined in issue #15')\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "ws": "^8.20.0",
    "zod": "^3.22.4"
  }
}
