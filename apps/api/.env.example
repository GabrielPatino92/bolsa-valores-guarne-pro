NODE_ENV=development
HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

DATABASE_URL=postgresql://guarne_dev:guarne_dev_pass_2024@localhost:5433/guarne_trading
DATABASE_POOL_MIN=0
